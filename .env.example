# Скопируйте этот файл в .env и заполните. Файл .env в репозиторий не попадает.

# Адрес трекера без /admin и без /admin_api/v1
KEITARO_URL=https://your-tracker.example.com
# Ключ из админки Keitaro: Профиль -> API ключи
KEITARO_API_KEY=

# База приложения. По умолчанию — файл SQLite рядом с проектом.
DATABASE_URL=sqlite:///./adrobot.db

# Префикс названий тестовых кампаний (добавляется автоматически)
CAMPAIGN_PREFIX=test_babloyan_

# Значения по умолчанию для новой кампании — ищутся в Keitaro по имени
DEFAULT_GROUP_NAME=FORTESTS
DEFAULT_SOURCE_NAME=FORTESTS
# Пусто — берётся первый активный домен
DEFAULT_DOMAIN_NAME=

# Куда первый поток отправляет посетителей из выбранной страны
GEO_REDIRECT_URL=https://google.com
